# Copy to backend/.env and fill in. Never commit the real .env.

# --- AI providers ---------------------------------------------------------
# Gemini is the primary provider for idea and story generation and is required.
GEMINI_API_KEY=
# Optional fallbacks, tried in order when the primary provider fails.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Auth -----------------------------------------------------------------
# Signs access (15 min) and refresh (30 day) tokens. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ISSUER=taelio
JWT_AUDIENCE=taelio-api

# --- Storage --------------------------------------------------------------
# SQLite by default. Any SQLAlchemy URL works (e.g. postgresql+psycopg://...).
# Note: alembic.ini also points at sqlite:///./taelio.db for migrations.
DATABASE_URL=sqlite:///./taelio.db

# Rate limiting uses Redis when reachable and falls back to in-memory buckets.
REDIS_URL=redis://localhost:6379
